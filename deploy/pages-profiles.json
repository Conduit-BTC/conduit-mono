{
  "schemaVersion": 1,
  "apps": {
    "market": {
      "package": "@conduit/market",
      "outputDirectory": "apps/market/dist",
      "cloudflareProject": "conduit-market",
      "cloudflareStagingProject": "conduit-market-signet"
    },
    "merchant": {
      "package": "@conduit/merchant",
      "outputDirectory": "apps/merchant/dist",
      "cloudflareProject": "conduit-merchant",
      "cloudflareStagingProject": "conduit-merchant-signet"
    },
    "store-builder": {
      "package": "@conduit/store-builder",
      "outputDirectory": "apps/store-builder/dist",
      "cloudflareProject": null,
      "cloudflareStagingProject": null
    }
  },
  "profiles": {
    "preview": {
      "releaseChannel": "preview",
      "lightningNetwork": "mainnet",
      "publicFeatures": {
        "dmCompatibilityOrderRoutingEnabled": true
      }
    },
    "production": {
      "releaseChannel": "production",
      "lightningNetwork": "mainnet",
      "publicFeatures": {
        "dmCompatibilityOrderRoutingEnabled": false
      }
    },
    "staging": {
      "releaseChannel": "staging",
      "lightningNetwork": "signet",
      "publicFeatures": {
        "dmCompatibilityOrderRoutingEnabled": true
      }
    }
  }
}
