{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "typeRoots": [
      "../node_modules/.bun/node_modules/@types",
      "../node_modules/.bun/node_modules"
    ],
    "paths": {
      "@conduit/core": ["../packages/core/src"],
      "@conduit/core/*": ["../packages/core/src/*"],
      "/src/*": ["../apps/market/src/*"],
      "@conduit/ui/theme": ["../packages/ui/src/theme/index.ts"]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "wallet-sign-in.playwright.ts",
    "wallet-layout.playwright.ts",
    "wallet-balances.playwright.ts",
    "wallet-addy-bootstrap.playwright.ts",
    "wallet-cross-app.playwright.ts",
    "wallet-reload.playwright.ts",
    "wallet-registry-removal.playwright.ts",
    "wallet-lifecycle.playwright.ts",
    "shared-ui-composition.playwright.ts",
    "shared-ui-populated-audit.playwright.ts",
    "shared-ui-surface-audit.playwright.ts",
    "merchant-invoice-source.playwright.ts",
    "commerce.playwright.ts",
    "merchant-product-image-preview.playwright.ts"
  ]
}
