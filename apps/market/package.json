{
  "name": "@conduit/market",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "routes:gen": "bun scripts/generate-routes.ts",
    "build": "bun ../../node_modules/@typescript/native/bin/tsc && vite build",
    "preview": "vite preview",
    "typecheck": "bun ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "dev:ui": "vite --config vite.ui.config.ts",
    "build:ui": "vite build --config vite.ui.config.ts",
    "preview:ui": "vite preview --config vite.ui.config.ts"
  },
  "dependencies": {
    "@buildonspark/spark-sdk": "0.14.0",
    "@conduit/core": "workspace:*",
    "@conduit/ui": "workspace:*",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "@scure/bip39": "2.4.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "lucide-react": "^1.67.0",
    "nostr-tools": "2.25.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.105.3",
    "@tanstack/router-core": "^1.171.16",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-generator": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vite": "^8.3.6"
  }
}
