{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conduit-posthog-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "routes": [
    {
      "pattern": "e.conduit.market",
      "custom_domain": true,
    },
  ],
  "ratelimits": [
    {
      "name": "GMV_GLOBAL_RATE_LIMITER",
      "namespace_id": "3001",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
    {
      "name": "GMV_ORDER_RATE_LIMITER",
      "namespace_id": "3002",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": false,
  },
}
