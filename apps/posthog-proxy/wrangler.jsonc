{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conduit-posthog-proxy",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-29",
  "durable_objects": {
    "bindings": [
      {
        "name": "GMV_DAILY_AGGREGATE",
        "class_name": "CommerceGmvDailyAggregate",
      },
      {
        "name": "GMV_CUTOVER_FENCE",
        "class_name": "CommerceGmvCutoverFence",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CommerceGmvDailyAggregate",
        "CommerceGmvCutoverFence",
      ],
    },
  ],
  "routes": [
    {
      "pattern": "e.conduit.market",
      "custom_domain": true,
    },
  ],
  "ratelimits": [
    {
      "name": "GMV_GLOBAL_RATE_LIMITER",
      "namespace_id": "3001",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
    {
      "name": "GMV_ORDER_RATE_LIMITER",
      "namespace_id": "3002",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": false,
  },
}
