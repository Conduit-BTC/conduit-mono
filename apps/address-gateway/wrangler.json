{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conduit-address-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "conduit.cash/*", "zone_name": "conduit.cash" }],
  "vars": {
    "ALLOWED_ORIGINS": "https://shop.conduit.market,https://sell.conduit.market,https://feat-conduit-cash-release.conduit-market-coo.pages.dev,https://feat-conduit-cash-release.conduit-merchant-33n.pages.dev",
    "TURNSTILE_HOSTNAMES": "shop.conduit.market,sell.conduit.market,feat-conduit-cash-release.conduit-market-coo.pages.dev,feat-conduit-cash-release.conduit-merchant-33n.pages.dev",
    "PROVIDER_PROXY_QUALIFIED": "false"
  },
  "d1_databases": [
    {
      "binding": "ADDRESS_REQUESTS",
      "database_name": "conduit-address-requests",
      "database_id": "449296aa-4ab8-448f-95ea-1694cfe81f87",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "4001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": false },
  "env": {
    "preview": {
      "name": "conduit-address-gateway-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:7000,http://localhost:7001",
        "TURNSTILE_HOSTNAMES": "localhost",
        "PROVIDER_PROXY_QUALIFIED": "false"
      },
      "d1_databases": [
        {
          "binding": "ADDRESS_REQUESTS",
          "database_name": "conduit-address-requests-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "REQUEST_RATE_LIMITER",
          "namespace_id": "4002",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
