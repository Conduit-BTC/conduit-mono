{
  "name": "@conduit/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./protocol/*": "./src/protocol/*.ts",
    "./pricing": "./src/pricing/index.ts",
    "./pricing/trusted-rate-provider": "./src/pricing/trusted-rate-provider.ts",
    "./wallets": "./src/wallets/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./utils": "./src/utils/index.ts",
    "./config": "./src/config.ts",
    "./telemetry-contract": "./src/telemetry-contract.ts",
    "./db": "./src/db/index.ts",
    "./context/*": "./src/context/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@getalby/sdk": "^8.0.3",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.2.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "clsx": "^2.1.1",
    "country-list": "^2.4.1",
    "dexie": "^4.4.5",
    "libphonenumber-js": "^1.13.12",
    "nostr-tools": "2.25.0",
    "posthog-js": "^1.391.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@types/country-list": "^2.1.4",
    "@types/react": "^19.2.18",
    "typescript": "^6.0.3"
  }
}
