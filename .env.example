# Conduit Environment Configuration

# Optional relay overrides for forks/operators.
# Conduit-hosted deploys leave these empty; the canonical code list lives in packages/core/src/config.ts.
VITE_RELAY_URL=
VITE_DEFAULT_RELAY_URL=
VITE_DEFAULT_RELAYS=
VITE_APP_WRITE_RELAY_URLS=
VITE_PUBLIC_RELAY_URLS=
VITE_COMMERCE_RELAY_URLS=
VITE_CACHE_API_URL=

# Lightning network: mainnet | signet | testnet | mock
VITE_LIGHTNING_NETWORK=mainnet

# Existing-account nsec sign-in in browser tabs and installed apps.
# Local development override; managed builds use deploy/pages-profiles.json.
VITE_ENABLE_LOCAL_KEY_SIGNER=true

# Local-only public, static Spark treasury settings. Managed mainnet preview
# and production builds use the shared deploy/pages-profiles.json policy;
# dashboard overrides are ignored, and Signet staging clears these settings.
# No private key. Explicit local/regtest settings remain isolated from mainnet.
# Missing local configuration preserves the Lightning fee rail for new plans;
# malformed or wrong-network configured addresses fail closed.
VITE_CONDUIT_SPARK_TREASURY_ADDRESS=
VITE_CONDUIT_SPARK_REGTEST_TREASURY_ADDRESS=
# Local-only prior approvals; managed rotation uses retiredMainnetAddresses in
# deploy/pages-profiles.json so funded plans stay immutable in both apps.
VITE_CONDUIT_SPARK_RETIRED_TREASURY_ADDRESSES=

# Explicit local pricing rollout; missing/invalid values retain signed-v1.
# Managed builds bind this choice in deploy/pages-profiles.json and its trust digest.
# Managed preview/production selection is independent of this local default.
VITE_CHECKOUT_SPARK_PRICING_POLICY=signed-v1

# Blossom media server
VITE_BLOSSOM_SERVER_URL=https://blossom.conduit.market

# NIP-89 application handler metadata
VITE_NIP89_RELAY_HINT=
VITE_NIP89_MARKET_PUBKEY=
VITE_NIP89_MERCHANT_PUBKEY=
VITE_NIP89_MARKET_D_TAG=conduit-market
VITE_NIP89_MERCHANT_D_TAG=conduit-merchant

# Breez-hosted Lightning addresses. Disabled until provider/domain live evidence.
# Browser-visible Breez public-client integration credential, intentionally not secret.
# Wallet ownership/registration authority comes from signed Spark identity requests.
# Namespace/name-abuse controls are a separate Breez provider-policy question.
# Local development only; deployed enablement comes from deploy/pages-profiles.json.
VITE_BREEZ_LIGHTNING_ADDRESS_ENABLED=false
VITE_BREEZ_LNURL_DOMAIN=breez.tips
VITE_BREEZ_SPARK_API_KEY=

VITE_ADDRESS_REQUEST_TURNSTILE_SITE_KEY=
